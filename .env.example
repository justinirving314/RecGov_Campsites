# Copy to .env and fill in what you need. Every setting is optional except a login password
# whenever the app is reachable from anywhere but your own computer.

# --- Web app ---------------------------------------------------------------------------------
# Password for the web app. Required if this runs anywhere other devices can reach.
CAMPWATCH_APP_PASSWORD=
# Set to true when the app is served over HTTPS (Tailscale serve, a cloud host, a reverse proxy).
CAMPWATCH_COOKIE_SECURE=false
# Where the SQLite database and generated session key live.
CAMPWATCH_DATA_DIR=data

# --- Checking ----------------------------------------------------------------------------------
# Seconds between checks (minimum 30). Each check makes one request per campground per month.
CAMPWATCH_POLL_INTERVAL_SECONDS=60
# Pause between requests within one check, to be polite to Recreation.gov.
CAMPWATCH_REQUEST_DELAY_SECONDS=1.0

# --- Alerts: set up one or more ----------------------------------------------------------------
# ntfy (easiest for iPhone): install the free ntfy app and subscribe to this topic.
# Anyone who knows the topic name can read it, so make it long and random.
CAMPWATCH_NTFY_TOPIC=
CAMPWATCH_NTFY_SERVER=https://ntfy.sh
# Only for a protected topic or a self-hosted server with access control.
CAMPWATCH_NTFY_TOKEN=

# Pushover (one-time app purchase): https://pushover.net
CAMPWATCH_PUSHOVER_USER_KEY=
CAMPWATCH_PUSHOVER_APP_TOKEN=

# Email. For Gmail, use smtp.gmail.com, port 465, and an app password (not your real password).
CAMPWATCH_SMTP_HOST=
CAMPWATCH_SMTP_PORT=465
CAMPWATCH_SMTP_USERNAME=
CAMPWATCH_SMTP_PASSWORD=
CAMPWATCH_SMTP_FROM=
# Comma-separated list of recipients.
CAMPWATCH_EMAIL_TO=

# --- Optional, experimental: hold sites in your Recreation.gov cart ----------------------------
# Needs: uv sync --extra booking && uv run playwright install chromium
CAMPWATCH_RECGOV_EMAIL=
CAMPWATCH_RECGOV_PASSWORD=
CAMPWATCH_BOOKING_HEADLESS=true
